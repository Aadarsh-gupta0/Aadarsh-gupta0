<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>JobPulse</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<!-- Points the app at your backend. Change this one value to move between
	     the simulator, a Mac on your LAN, and a deployed server. -->
	<key>JOBPULSE_API_BASE_URL</key>
	<string>http://127.0.0.1:8000</string>
	<key>JOBPULSE_API_KEY</key>
	<string></string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!-- Needed so a tapped alert can wake the app and fetch the job. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.aadarsh.jobpulse</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jobpulse</string>
			</array>
		</dict>
	</array>

	<!-- Development only: allows plain HTTP to a locally hosted backend.
	     Remove this whole dictionary once the API is served over HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
