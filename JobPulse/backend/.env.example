# Copy to .env and fill in. Every key is optional except the APNs block,
# which is required before notifications actually leave the machine.

# --- general ---------------------------------------------------------------
JOBPULSE_ENV=dev
JOBPULSE_DATABASE_URL=sqlite+pysqlite:///./jobpulse.db
# Set to require an X-API-Key header on /v1/admin/* endpoints.
# JOBPULSE_API_KEY=change-me

# --- ingestion -------------------------------------------------------------
JOBPULSE_INGEST_INTERVAL_MINUTES=30
JOBPULSE_ENABLED_SCRAPERS=remoteok,arbeitnow,himalayas,weworkremotely,hn_hiring,greenhouse,lever
JOBPULSE_GREENHOUSE_BOARDS=figma,canva,razorpay,postman,gitlab
JOBPULSE_LEVER_BOARDS=swiggy,netflix
JOBPULSE_RESPECT_ROBOTS_TXT=true
JOBPULSE_PER_HOST_DELAY_SECONDS=1.5

# --- matching --------------------------------------------------------------
# Stored in the feed at/above this score.
JOBPULSE_MATCH_THRESHOLD=0.35
# Sends a push at/above this score.
JOBPULSE_NOTIFY_THRESHOLD=0.55
JOBPULSE_MAX_PUSHES_PER_DEVICE_PER_RUN=4
JOBPULSE_QUIET_HOURS_START=22
JOBPULSE_QUIET_HOURS_END=7

# --- APNs ------------------------------------------------------------------
# From the Apple Developer portal: Keys → create a key with APNs enabled.
JOBPULSE_APNS_USE_SANDBOX=true
JOBPULSE_APNS_TEAM_ID=ABCDE12345
JOBPULSE_APNS_KEY_ID=FGHIJ67890
JOBPULSE_APNS_AUTH_KEY_PATH=./secrets/AuthKey_FGHIJ67890.p8
JOBPULSE_APNS_TOPIC=com.aadarsh.jobpulse
